{
  "expo": {
    "name": "AI Kitchen",
    "slug": "ai-kitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ai-kitchen/brand/app-icon.png",
    "scheme": "ai-kitchen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ai-kitchen/brand/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F3",
        "foregroundImage": "./assets/images/ai-kitchen/brand/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moyoung.kerr.aikitchen"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F3",
          "image": "./assets/images/ai-kitchen/brand/splash-mark.png",
          "imageWidth": 180
        }
      ],
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
