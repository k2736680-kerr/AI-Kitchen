{
  "name": "@ai-kitchen/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate:up": "tsx src/scripts/migrate.ts up",
    "migrate:down": "tsx src/scripts/migrate.ts down"
  },
  "dependencies": {
    "@ai-kitchen/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "mysql2": "^3.14.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^4.1.10"
  }
}
