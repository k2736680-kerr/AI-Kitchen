# Supabase personal access token: Dashboard avatar -> Account Preferences -> Access Tokens
SUPABASE_ACCESS_TOKEN=

# Organization ID is not a password. Copy it from Organization Settings.
SUPABASE_ORG_ID=

# Leave blank when creating a new project; fill it to deploy to an existing project.
SUPABASE_PROJECT_REF=

# Choose a new strong database password for the Supabase project.
SUPABASE_DB_PASSWORD=

SUPABASE_PROJECT_NAME=ai-kitchen
SUPABASE_REGION=ap-southeast-1

# Optional for repeat deployments. Leave blank to preserve the existing Function Secret.
# Fill only when creating the project or rotating the DashScope key.
DASHSCOPE_API_KEY=
